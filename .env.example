# Copy values into your shell environment before starting the backend.
# The backend does not automatically load this file.
DIGITAL_TWIN_ENV=development
DIGITAL_TWIN_DEMO_MODE=false
AERION_ENABLE_ML_DIAGNOSTICS=0
DIGITAL_TWIN_HISTORY_LIMIT=1000
DIGITAL_TWIN_ADAPTER=SIMULATOR
# Supply unique values through a secret manager for authenticated deployments.
DIGITAL_TWIN_BOOTSTRAP_ADMIN_USERNAME=admin
DIGITAL_TWIN_BOOTSTRAP_ADMIN_PASSWORD=
DIGITAL_TWIN_TOKEN_SECRET=
